# ──────────────────────────────────────────────────────────────────────────────
# Foam — 环境变量配置模板
# 复制:  cp .env.example .env
# 优先级: 进程环境变量 > .env（仅填充未设置的键）> config.yaml > 代码默认值
# CLI 标志（如 --listen）在上述之后覆盖。
# docker compose 可 env_file: .env，或在 services.foam.environment 中注入。
# ──────────────────────────────────────────────────────────────────────────────

# ─── 配置文件 ──────────────────────────────────────────────────────────────────
# FOAM_CONFIG=./config.yaml
# FOAM_ENV_FILE=./.env

# ─── 服务 ──────────────────────────────────────────────────────────────────────
# FOAM_SERVER_LISTEN=127.0.0.1:8000
# FOAM_SERVER_MAX_BODY_BYTES=33554432
# FOAM_SERVER_READ_TIMEOUT=15m
# FOAM_SERVER_REQUEST_TIMEOUT=2h

# ─── 鉴权 ──────────────────────────────────────────────────────────────────────
# FOAM_AUTH_ACCESS_TOKEN_TTL=15m
# FOAM_AUTH_REFRESH_TOKEN_TTL=720h
# FOAM_AUTH_SECURE_COOKIES=false

# ─── 密钥（生产必须设置；可用环境变量代替写进 config.yaml）────────────────────
# 至少 32 字符: openssl rand -hex 32
FOAM_SECRETS_JWT_SECRET=replace-with-at-least-32-characters
# Base64 32 字节: openssl rand -base64 32
FOAM_SECRETS_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-key

# ─── 首次 bootstrap 管理员（库中尚无管理员时生效）──────────────────────────────
# FOAM_BOOTSTRAP_ADMIN_USERNAME=admin
FOAM_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# ─── 前端 / 静态 ───────────────────────────────────────────────────────────────
# FOAM_FRONTEND_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# FOAM_FRONTEND_STATIC_PATH=./frontend/dist

# ─── 数据库 ────────────────────────────────────────────────────────────────────
# sqlite | postgres
# FOAM_DATABASE_DRIVER=sqlite
# FOAM_DATABASE_SQLITE_PATH=./data/backend.db
# FOAM_DATABASE_POSTGRES_DSN=postgres://user:password@127.0.0.1:5432/foam?sslmode=disable
# FOAM_DATABASE_POSTGRES_MAX_OPEN_CONNS=50
# FOAM_DATABASE_POSTGRES_MAX_IDLE_CONNS=10

# ─── 其它 ──────────────────────────────────────────────────────────────────────
# TZ=Asia/Shanghai
# FOAM_VERSION=0.1.0
